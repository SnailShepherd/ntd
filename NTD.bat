@echo off
cd /d %~dp0

rem ============================================================
rem  Моментальный запуск: сборка отчёта NormaCS
rem ============================================================
rem Имя отчёта подставляется само - из самой свежей таблицы
rem в data\tables:   20260831.html  ->  out\20260831.html
rem
rem Что означают параметры в строке запуска:
rem   --doc-age-months 6 не брать документы старше 6 месяцев. Отсчёт идёт
rem                      от даты отчёта, а она берётся из имени итогового
rem                      файла: out\20260826.html -> 26 августа 2026, значит
rem                      порог 26 февраля 2026. Правится само, руками ничего
rem                      подставлять не нужно. Нужен другой период -
rem                      поменяйте число 6.
rem   --why              показывать по каждой строке, почему она отброшена
rem                      (старый год, нет нужных классификаторов и т.п.)
rem   --keep-cache 500   держать в кэше не больше 500 свежих карточек
rem   --keep-done   60   держать в data\done не больше 60 свежих таблиц
rem
rem Посмотреть, что удалилось бы, ничего при этом не удаляя:
rem   py -3 ntd.py --input-dir data\tables --dry --keep-cache 500 --keep-done 60
rem
rem ВНИМАНИЕ: весь русский текст печатает сам скрипт (Python) - он выводит
rem его через Unicode и потому всегда читаем. В самом .bat русских букв
rem в командах echo быть не должно: cmd выводит их через кодовую страницу
rem консоли и превращает в "крякозябры". Здесь по-русски - только эти
rem комментарии, они на экран не попадают.

py -3 ntd.py --input-dir data\tables --doc-age-months 6 --why --keep-cache 500 --keep-done 60

echo.
if errorlevel 1 (
    echo ==============================================================
    echo   ERROR - the report was NOT built. See the message above.
    echo ==============================================================
    echo.
)
pause
